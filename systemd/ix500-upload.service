[Unit]
Description=Upload queued iX500 PDFs and check Paperless tasks
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/ix500-paperless/config.json

[Service]
Type=oneshot
User=ix500
Group=ix500
ExecStart=/usr/bin/python3 /opt/ix500-paperless/appliance.py upload
TimeoutStartSec=infinity
TimeoutStopSec=20
StateDirectory=ix500-paperless
StateDirectoryMode=0700
UMask=0077
Environment=LC_ALL=C PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ix500-paperless
