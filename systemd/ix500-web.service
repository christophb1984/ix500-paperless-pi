[Unit]
Description=ScanSnap local scan management web UI
After=local-fs.target ix500-scan.service
ConditionPathExists=/etc/ix500-paperless/config.json
ConditionPathExists=/etc/ix500-paperless/web.json

[Service]
Type=simple
User=ix500
Group=ix500
ExecStart=/usr/bin/python3 /opt/ix500-paperless/webapp.py
Restart=on-failure
RestartSec=5
StateDirectory=ix500-paperless
StateDirectoryMode=0700
UMask=0077
Environment=LC_ALL=C PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ix500-paperless

[Install]
WantedBy=multi-user.target
